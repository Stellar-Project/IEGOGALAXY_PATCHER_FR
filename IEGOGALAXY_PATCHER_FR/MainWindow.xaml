                </Viewbox>
            </Button>
            <Button Click="BtnAbout_Click" ToolTip="À propos">
                <Viewbox Width="16" Height="16">
                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                          Data="M11,18H13V16H11V18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,6A4,4 0 0,0 8,10H10A2,2 0 0,1 12,8A2,2 0 0,1 14,10C14,12 11,11.75 11,15H13C13,12.75 16,12.5 16,10A4,4 0 0,0 12,6Z"/>
                </Viewbox>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <mah:Flyout x:Name="FlyoutSettings" Header="Paramètres" Position="Right" Width="300" Theme="Adapt">
                <StackPanel Margin="20">
                    <TextBlock Text="Apparence" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource MahApps.Brushes.Accent}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Thème de l'application :" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ComboTheme" SelectionChanged="ComboTheme_SelectionChanged" SelectedIndex="0">
                        <ComboBoxItem Content="Par rapport au système"/>
                        <ComboBoxItem Content="Mode Sombre (Dark)"/>
                        <ComboBoxItem Content="Mode Clair (Light)"/>
                    </ComboBox>

                    <TextBlock Text="Le mode système suit la configuration de Windows 10/11." FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="INAZUMA ELEVEN GO GALAXY" 
                       FontSize="26" FontWeight="Black" HorizontalAlignment="Center" 
                       Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,0,0,5"/>
            <TextBlock Text="PATCH FRANÇAIS - INSTALLATEUR" 
                       FontSize="16" FontWeight="Light" HorizontalAlignment="Center" 
                       Foreground="{DynamicResource MahApps.Brushes.Text}" Opacity="0.7" Margin="0,0,0,30"/>

            <GroupBox Header="1. Version du jeu" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="10">
                    <RadioButton x:Name="RbBigbang" Content="Bigbang" IsChecked="True" Margin="0,0,30,0" Checked="UpdatePath_Event" FontSize="14"/>
                    <RadioButton x:Name="RbSupernova" Content="Supernova" Checked="UpdatePath_Event" FontSize="14"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2. Plateforme cible" Margin="0,0,0,20">
                <StackPanel Margin="10">
                    <RadioButton x:Name="RbCitra" Content="Émulateur Citra (Officiel)" IsChecked="True" Checked="UpdatePath_Event" Margin="0,0,0,10" FontSize="14"/>
                    <RadioButton x:Name="RbAzahar" Content="Émulateur Azahar" Checked="UpdatePath_Event" Margin="0,0,0,10" FontSize="14"/>
                    <RadioButton x:Name="RbConsole" Content="Console (3DS Hackée / Luma)" Checked="UpdatePath_Event" FontSize="14"/>
                </StackPanel>
            </GroupBox>

            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtPath" mah:TextBoxHelper.Watermark="Chemin d'installation détecté..." IsReadOnly="True" Height="30" FontSize="13"/>
                <Button Grid.Column="1" Content="..." Width="40" Margin="5,0,0,0" Click="BtnBrowse_Click"/>
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnPatch" 
                    Grid.Column="0"
                    Content="Télécharger et Installer le patch" 
                    Height="55" 
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    FontSize="18" 
                    FontWeight="Bold" 
                    Click="BtnPatch_Click" 
                    Cursor="Hand"
                    mah:ControlsHelper.ContentCharacterCasing="Normal"/>
                <Button x:Name="BtnCancel" 
                    Grid.Column="1"
                    Content="Annuler" 
                    Height="55" 
                    Width="100"
                    Margin="10,0,0,0"
                    FontSize="14"
                    IsEnabled="False"
                    Click="BtnCancel_Click" 
                    Cursor="Hand"/>
                <Button x:Name="BtnRestore" 
                    Grid.Column="2"
                    Content="Restaurer" 
                    Height="55" 
                    Width="100"
                    Margin="10,0,0,0"
                    FontSize="14"
                    Click="BtnRestore_Click" 
                    Cursor="Hand"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource MahApps.Brushes.Control.Background}" 
                    BorderBrush="{DynamicResource MahApps.Brushes.Accent}" 
                    BorderThickness="1" 
                    Padding="12,10" 
                    MinHeight="50"
                    Margin="0,0,0,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblStatus" 
                               Grid.Column="0"
                               Text="En attente" 
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" 
                               FontSize="14"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="LblPercentage" 
                               Grid.Column="1"
                               Text="" 
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="10,0,0,0"
                               Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                </Grid>
            </Border>

            <mah:MetroProgressBar Grid.Row="1" x:Name="ProgressBar" Height="18" Maximum="100"/>
        </Grid>
    </Grid>
</mah:MetroWindow>